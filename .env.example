# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- BSC RPC ---
# Public RPC for now — swap to a paid provider (QuickNode/Chainstack/Ankr) when ready.
BSC_RPC_HTTP=https://bsc-dataseed.binance.org
BSC_RPC_WSS=wss://bsc-ws-node.nariox.org:443

# --- Wallet ---
# Private key for the trading wallet. NEVER commit this. Railway env vars only.
WALLET_PRIVATE_KEY=

# --- Contracts (BSC mainnet) ---
# Confirmed address for four.meme's TokenManager2 (handles token creation for
# tokens created after Sept 5 2024). Override only if four.meme migrates
# contracts. See src/listeners/fourMemeListener.js for sourcing + caveats.
FOUR_MEME_FACTORY_ADDRESS=0x5c952063c7fc8610FFDB798152D69F0B9550762b
PANCAKESWAP_V2_FACTORY=0xcA143Ce32Fe78f1f7019d7d551a6402fC5350c73
PANCAKESWAP_V2_ROUTER=0x10ED43C718714eb63d5aA57B78B54704E256024E
WBNB_ADDRESS=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c

# --- Trading mode (initial boot value only — /mode switches it live after that) ---
# paper | live
TRADING_MODE=paper

# --- Gas ---
MAX_GAS_PRICE_GWEI=5

# --- Database ---
DB_PATH=./data/bot.db

# --- Optional: holder concentration check ---
# Free key from https://etherscan.io/apis — Etherscan's unified V2 API
# covers BSC too via chainid=56, one key works across all EVM chains.
# Without this set, the holder-concentration check is skipped (soft
# failure) rather than blocking all trading.
ETHERSCAN_API_KEY=

# NOTE: trade size, gas reserve, max positions, min liquidity, min/max market
# cap, max holder %, take profit, and stop loss are NOT set here — they're
# runtime-adjustable via Telegram commands (/setsize, /setgasreserve, etc.)
# and persisted in the SQLite DB. See src/utils/settings.js for defaults.
