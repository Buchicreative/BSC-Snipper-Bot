# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- BSC RPC ---
# Public RPC for now — swap to a paid provider (QuickNode/Chainstack/Ankr) when ready.
# The WSS endpoint auto-reconnects with backoff if it drops (public endpoints
# do this periodically) — see src/utils/resilientWsProvider.js.
BSC_RPC_HTTP=https://bsc-dataseed.binance.org
BSC_RPC_WSS=wss://bsc-rpc.publicnode.com

# --- Contracts (BSC mainnet) ---
# Confirmed address for four.meme's TokenManager2 (handles token creation for
# tokens created after Sept 5 2024). Override only if four.meme migrates
# contracts. See src/listeners/fourMemeListener.js for sourcing + caveats.
FOUR_MEME_FACTORY_ADDRESS=0x5c952063c7fc8610FFDB798152D69F0B9550762b
PANCAKESWAP_V2_FACTORY=0xcA143Ce32Fe78f1f7019d7d551a6402fC5350c73
PANCAKESWAP_V2_ROUTER=0x10ED43C718714eb63d5aA57B78B54704E256024E
WBNB_ADDRESS=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c

# --- Gas ---
MAX_GAS_PRICE_GWEI=5

# --- Database ---
DB_PATH=./data/bot.db

# --- Multi-user wallets (REQUIRED for anyone to use /generatewallet or /importwallet) ---
# 64-character hex string (32 bytes) used to encrypt every stored private key
# at rest. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this key makes every stored wallet unrecoverable — back it up
# somewhere other than just Railway's env vars (a password manager works fine).
# NEVER reuse a key you've shared anywhere else.
WALLET_ENCRYPTION_KEY=

# Comma-separated Telegram numeric user IDs allowed to import/generate a
# wallet and trade on this bot. Get your own ID by messaging @userinfobot on
# Telegram. Anyone not on this list can still message the bot, but every
# command is politely refused. Example: ALLOWED_TELEGRAM_USER_IDS=123456789,987654321
ALLOWED_TELEGRAM_USER_IDS=

# --- Optional: holder concentration check ---
# Free key from https://etherscan.io/apis — Etherscan's unified V2 API
# covers BSC too via chainid=56, one key works across all EVM chains.
# Without this set, the holder-concentration check is skipped (soft
# failure) rather than blocking all trading.
ETHERSCAN_API_KEY=

# NOTE: trading mode, trade size, gas reserve, max positions, min liquidity,
# min/max market cap, max holder %, tax caps, take profit, and stop loss are
# NOT set here — every one of these is per-user and runtime-adjustable via
# Telegram commands (/setsize, /setgasreserve, /mode, etc.). Each Telegram
# user who registers a wallet gets their own independent copy of all of
# these, defaulting to paper mode. See src/utils/userSettings.js and
# src/utils/userBotState.js for defaults.
